{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "rewrites": [
    {
      "source": "/api/blob-upload",
      "destination": "/api/blob-upload.js"
    },
    {
      "source": "/api/blob-delete",
      "destination": "/api/blob-delete.js"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.php"
    }
  ]
}
