{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/api/blob-upload",
      "dest": "/api/blob-upload.js"
    },
    {
      "src": "/api/blob-delete",
      "dest": "/api/blob-delete.js"
    },
    {
      "src": "^/$",
      "dest": "/api/index.php"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
